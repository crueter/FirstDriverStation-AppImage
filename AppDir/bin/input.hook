#!/bin/sh
set -e

# udev hook but also gives the FirstDriverStation binary the needed capabilities

# Helper script in POSIX shell to install udev rules

# checks if the bundled udev rules are installed, checks in multiple places
# to make sure they were not installed by other means, then informs the user
# that the udev rules need to be installed, then it will
# use pkexec or lxqt-sudo to gain rights to install them
# at /usr/local/lib/udev

# Note this will only install udev rules, nothing else, some rules require the
# user to be in a group, in that case you will need to change this script

_disable_udev=$CACHEDIR/.${APPIMAGE##*/}-udev-check-disabled

# make sure we have the needed deps
_udev_installer_check() {
	if [ "$CI" = 'true' ]; then
		return 1
	elif [ -f "$_disable_udev" ] || [ -z "$APPDIR" ] || [ -z "$APPIMAGE" ]; then
		return 1
	elif ! is_cmd cp mkdir; then
		return 1
	elif ! run_gui_sudo --check; then
		return 1
	fi

	for d in "$APPDIR"/etc/udev/rules.d "$APPDIR"/lib/udev/rules.d; do
		if [ -d "$d" ]; then
			_bundled_udev_rules=$d
			return 0
		fi
	done

	return 1
}

_is_rule_already_installed() {
	# Add any possible udev files in the array
	set -- "$_bundled_udev_rules"/*

	# check if it is already installed on the host, check in multiple
	# places since they could be installed by distro or other means
	for f; do
		if [ -f /etc/udev/rules.d/"${f##*/}" ] ||
			[ -f /usr/lib/udev/rules.d/"${f##*/}" ] ||
			[ -f /usr/local/lib/udev/rules.d/"${f##*/}" ]; then
			shift
		fi
	done

	# bundled udev rules are already installed if the array is empty
	[ -n "$1" ] || return 1
}

# copy sharun to a writable non-nosuid location so we can give the copy file
# capabilities and launch the real binary through it, returns 0 on success and
# sets _workaround_path/_caps_bin
_input_prepare_workaround() {
	if [ "$CI" = 'true' ] || [ -z "$APPDIR" ] || [ -z "$APPIMAGE" ]; then
		return 1
	elif [ ! -f "$APPDIR"/bin/FirstDriverStation ]; then
		return 1
	fi

	for dep in setcap getcap ln mkdir cp grep; do
		is_cmd "$dep" || { notify -ne "Missing dependency: $dep"; return 1; }
	done

	# find a writable location that is not mounted with nosuid
	if ! grep -q '/tmp .*nosuid' /proc/mounts; then
		_workaround_path=/tmp/.fds-appimage-hack
	elif [ -w /var/tmp ] && ! grep -qE '/var/tmp .*nosuid|/var .*nosuid' /proc/mounts; then
		_workaround_path=/var/tmp/.fds-appimage-hack
	else
		_workaround_path=$CACHEDIR/fds-appimage-hack
	fi

	# some distros don't include sbin in PATH
	export PATH="$_workaround_path/bin:$PATH:/usr/local/sbin:/usr/sbin:/sbin"

	mkdir -p "$_workaround_path"/bin

	# hack to get capabilities working
	if [ ! -f "$_workaround_path"/.done ] || [ ! -f "$_workaround_path"/bin/FirstDriverStation ]; then
		cp "$APPDIR"/sharun "$_workaround_path"
		cp "$APPDIR"/.env "$_workaround_path" 2>/dev/null || :
		cp "$APPDIR"/.preload "$_workaround_path" 2>/dev/null || :
		rm -f "$_workaround_path"/bin/FirstDriverStation
		cp "$_workaround_path"/sharun "$_workaround_path"/bin/FirstDriverStation
		: > "$_workaround_path"/.done
	fi

	ln -sfn "$APPDIR"/etc "$_workaround_path"/etc
	ln -sfn "$APPDIR"/lib "$_workaround_path"/lib
	ln -sfn "$APPDIR"/share "$_workaround_path"/share
	ln -sfn "$APPDIR"/shared "$_workaround_path"/shared

	_caps_bin=$_workaround_path/bin/FirstDriverStation
	return 0
}

# caps and udev setup as one command
# adapted from udev-installer and gpu screen recorder's nonsense
input_setup() {
	_input_prepare_workaround || return 0

	# figure out what is missing
	_udev_needed=""
	if _udev_installer_check && _is_rule_already_installed; then
		_udev_needed=1
	fi
	_caps_needed=""
	if [ -z "$(getcap "$_caps_bin" 2>/dev/null)" ]; then
		_caps_needed=1
	fi

	if [ -z "$_udev_needed" ] && [ -z "$_caps_needed" ]; then
		# everything is set up, launch as usual through the capped copy
		APPDIR=$_workaround_path
		export APPDIR
		return 0
	fi

	_sudo_cmd=""
	if [ -n "$_udev_needed" ]; then
		# due to some weird issue I noticed in kubuntu, we do not have
		# permission to copy the dir from the FUSE filesystem to /usr/local
		# we need to instead copy the dir first to /tmp and then
		# copy it over to /usr/local...
		_tmp_udev_dir=${TMPDIR:-/tmp}/.tmp-udev-rules-${APPDIR##*/}
		rm -rf "$_tmp_udev_dir"
		mkdir -p "$_tmp_udev_dir"
		cp -rv "$_bundled_udev_rules"/* "$_tmp_udev_dir"
		_sudo_cmd="$_sudo_cmd
          mkdir -p /usr/local/lib/udev/rules.d
          cp -v '$_tmp_udev_dir'/* /usr/local/lib/udev/rules.d
          command -v udevadm && udevadm control --reload-rules"
	fi

	if [ -n "$_caps_needed" ]; then
		# cap_dac_override is equivalent to being in the input group
		_sudo_cmd="$_sudo_cmd
          setcap cap_dac_override+ep '$_caps_bin'"
	fi

	if [ -n "$_udev_needed" ]; then
		_msg="${APPIMAGE##*/} needs input permissions in order to work. Do you wish to set them up now?"
		if ! notify --display-question "$_msg"; then
			if notify -dq "Do you wish to not see this message again?"; then
				mkdir -p "$CACHEDIR"
				: > "$_disable_udev"
			fi
			return 0
		fi
	fi

	if ! run_gui_sudo --check; then
		err_msg "No 'pkexec' or 'lxqt-sudo' or 'run0' found!"
		err_msg "We are going to continue but things will likely break"
		return 0
	fi

	run_gui_sudo sh -c "$_sudo_cmd" || {
		err_msg "Failed to set up input permissions!"
		err_msg "You may fix this manually by running: sudo $_sudo_cmd"
		return 0
	}

	if [ -n "$_udev_needed" ]; then
		notify -ni "Input rules installed"
	fi

	# override APPDIR now so that the AppRun launches the right binaries
	APPDIR=$_workaround_path
	export APPDIR
}

input_setup || :
